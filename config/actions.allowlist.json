  "include_operation_ids": [
    "listWorkflows",
    "createWorkflow",
    "getWorkflow",
    "updateWorkflow",
    "deleteWorkflow",
    "activateWorkflow",
    "deactivateWorkflow",
    "listExecutions",
    "getExecution",
    "deleteExecution",
    "retryExecution",
    "stopExecution",
    "listCredentials",
    "getCredential",
    "deleteCredential",
    "getCredentialSchema",
    "listVariables",
    "createVariable",
    "updateVariable",
    "deleteVariable",
    "listProjects",
    "generateAudit"
